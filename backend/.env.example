# Copy to .env (git-ignored) or export these in your shell before running the backend.
# The app reads them via Spring's ${...} placeholders in application.properties.

# REQUIRED — password for the PostgreSQL user below.
DB_PASSWORD=postgrespassword

# JWT signing secret. Must be >= 32 bytes (jjwt rejects shorter HMAC keys at startup).
# Leave unset to use the insecure dev default in application.properties.
# JWT_SECRET=dev-only-insecure-secret-at-least-32-bytes-long

# Comma-separated CORS origins for the frontend dev server.
# CORS_ORIGINS=http://localhost:5173

# Datasource overrides (defaults shown; only needed if your Postgres differs).
# spring.datasource.url=jdbc:postgresql://localhost:5432/shopstack_db
# spring.datasource.username=postgres
